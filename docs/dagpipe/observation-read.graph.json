{
  "id": "humanagent-observation-read",
  "version": "4",
  "meta": {
    "title": "按授权范围读取事实，经统一语义归类与配对渲染多视角观测",
    "designStatus": "candidate",
    "capabilityStatus": "pending",
    "prototypeBoundary": "docs/ui/semantic-observation-tour.html is a standalone semantic Mock design; it does not consume or prove this production chain",
    "browserDesignContract": "Shared semantic controls compose all views; declared events connect modules; immutable payload references are shared along data arcs; unknown/stale/empty and evidence remain explicit",
    "payloadReferenceStatus": "candidate browser shared-reference contract; native Arc type and production wiring remain pending",
    "agentActivityContract": "Task-scoped instance ownership is read from actual native bindings, acquired incarnations, resumed segments and owner-decoded Journal receipts. It reaches semantic projection through the direct task_projection arc; event normalization and role frames never generate or replace instance identity.",
    "agentActivityOwner": "packages/runtime/src/observation/agent-activity.ts selects exact typed ownership; packages/app/src/ui-runtime/agent-activity-read.ts reads existing owner decoders; packages/ui/projection/agent-activity.ts projects the same source; docs/ui/agent-activity.js renders it without control effects. The published task-scoped read slice is implemented and proven; cross-scope aggregation and live closure remain pending.",
    "i2HistoryContract": "Six I2 read contracts (inspection occurrences, inspection occurrence entry, milestone reviews, business cycles, business cycle entry and inspection comparison) are carried from load_task_truth to project_semantic_views on the direct task_projection arc. Each contract can carry a task read scope identifying projectKey, mode and taskId. This diagram only declares the projection boundary and does not claim that cross-project App reads or browser consumption are implemented.",
    "terminalContract": {
      "success": "rendered_view",
      "failure": "explicit stale/disconnected/unmapped projection; no raw inference or fake live state",
      "cancel": "last durable projection remains readable",
      "blocked": "scope, semantic coverage, project or agent identity unavailable is explicit",
      "cleanup": "read-only projection closes with no runtime mutation"
    }
  },
