{
  "id": "humanagent-native-turn-segment-recovery",
  "version": "2",
  "meta": {
    "title": "同一业务 turn 的 segment 冷恢复",
    "requirements_version": 19,
    "requirements": [
      "humanagent-standard-turn-closure-forced-reasoning-and-same-turn-recovery",
      "humanagent-explicit-brain-semantic-turn-context",
      "humanagent-implicit-brain-budgeted-independent-orchestration",
      "humanagent-dynamic-orchestrator-choice-and-agent-termination",
      "humanagent-turn-checkpoint-four-part-summary-and-planner-iteration",
      "humanagent-transient-goal-oriented-continuation-prompt",
      "humanagent-generic-reorientation-prompt-and-boolean-stop-control",
      "humanagent-continuation-oriented-by-explicit-dispatch-template",
      "humanagent-provider-work-order-ablate-graph-governance-code"
    ],
    "designStatus": "USER-REQUIREMENT-DESIGN",
    "implementationStatus": "UNVERIFIED",
    "effectLedgerContract": "恢复前先读取在途 effect ledger、收拢在途请求与副作用、执行安全分流并持久保存恢复 checkpoint，均位于新 segment 授权登记与打开之前；readonly 或已提交条目走 auto_resume_same_turn_segment -> register_current_grant_business -> append_segment_opened -> establish_epoch_window，任何 mutating 且 dispatched-effect-unknown 条目走 enter_recovery_hold 直接输出 durable blocked（不获取执行实例、不追加可运行 successor segment）。",
    "scope": "一次同一业务 turn 的 resume intent；单输入单输出 SESE；不派发固定 observation/plan/execute/review 角色流水线，无重复/回退边，下一次恢复是本图的新执行",
    "seseBoundary": "一个 resume intent 输入 ARC（唯一公开产出者为 App 选择器 resolveColdExecutionResumeRequest(input:{taskId,operationId})，DESIGN-PLANNED/UNVERIFIED target；组合与索引入口只暴露这一个 owner，不新增 select/fallback 平行路径；HTTP 调用方只提供 operationId），一个 typed recovery/resume outcome 输出 ARC。",
    "routingContract": "已安装 DAGpipe 0.1.1 grammar 只有无条件 from/to/arc_id 边，执行器按拓扑波次调度全部节点，无条件边。因此 prerequisite/error 由 typed envelope 承载：节点只在其入边 envelope 声明精确前置成功后执行副作用，否则输出 not-executed 并保留原首错；链条仍到达唯一输出节点，由该节点解析 typed outcome。此为目标拓扑与合同，不证明 runtime 路由。",
    "predecessorFact": "恢复前驱有三类真实事实：已提交 captured recovery receipt；已打开但未保存的 interrupted anchor（真实 segment-opened commit 与 records-through commit）；以及无任何已提交 receipt/中断段的 initial-open 原 turn anchor（binding commit 与 records-through commit）。其余情况保持 failed/unknown 原出口。分类唯一 owner 是 App native-recovery-assets 组合读取端口；Runtime 只消费 typed 结果，不把 interrupted 或 initial-open 叫作 capture。三类前驱在 read_exact_predecessor_facts 内分类，不为 union 分支新增节点。",
    "resumeNotSaveGate": "恢复成功不要求先保存本 segment 的 v2 capture、producer drain 或 recovery-assets receipt。原崩溃在保存前被杀，因此 save/drain 不能作为 resume 前置。v2 capture 仍由真实保存边界（native-save/boundary close）产出，该保存不属于本图节点。",
    "epochFloorOrder": "successorEpoch 由全部真实 durable floor facts（原 v1 epoch、已提交 segments、当前 context、operation/retry 记录）计算，先于 grant reservation commit；segment-opened commit 将新 epoch 固定到该新段。旧 epoch 迟到写按 fencing 拒绝。",
    "commitSeparation": "grant commit、business registration commit、segment commit 三种职责分离：安全自动续跑分支的 register_current_grant_business 在同一 held 事务内产出 grant commit 与 business registration commit；append_segment_opened 产出独立 segment commit。禁止用任一 commit 填充另一职责。",
    "dispatchBoundary": "hydrate 与 GET 只恢复事实，不恢复执行许可。普通 dispatch 不得因恢复出的 running 状态重新执行；只有既有 cold generation 路径消费已提交 successor segment 后，受控 retained dispatch 才能继续已获取的执行。",
    "revokeOrder": "reservation 提交前撤权：零登记、零 append、零 dispatch；reservation 提交后撤权：允许完成本次已登记 segment 的 append 与收拢，但新 request、child、effect 仍各自按当前 grant 逐次准入。",
    "immutability": "原 v1 initial capture、原 binding commit 与原业务 turn 身份（originalBusinessIdentity）保持不可变；本图只追加新 segment，不重标旧 epoch、不重写 v1 receipt、不要求旧 interrupted segment 补写 v2 capture。",
    "reuseBoundary": "复用 native-turn-checkpoint.graph.json 的节点 schema；本图不证明 Operator 已注册、runtime 已执行或产品已验收。",
    "nodeGranularity": "先读取前驱事实、读取 effect ledger、收拢在途操作、判定安全分流并提交 recovery checkpoint；安全分支随后执行 grant/业务登记、append 新 segment、恢复 epoch/window，Hold 分支直接收敛至 typed 结果；不把模块内部普通函数拆成节点。",
    "bindingCompanion": "native-turn-segment-recovery.graph.binding.json",
    "semanticCompanion": "native-turn-segment-recovery.graph.semantic.json"
  },
