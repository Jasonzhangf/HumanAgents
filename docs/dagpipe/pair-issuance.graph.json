{
  "id": "humanagent-pair-issuance",
  "version": "2",
  "meta": {
    "title": "配对码签发：产品 root 本地直达持久凭证",
    "designStatus": "candidate",
    "capabilityStatus": "pending",
    "requirementsVersion": 16,
    "terminalContract": {
      "success": "pairing code receipt：公开 CLI 返回 command、code 与 ISO expiresAt；不读取 workspace、lease、supervisor endpoint 或 HTTP",
      "beforeServe": "普通签发发生在 serve 之前；只有持久凭证写入失败才失败",
      "restart": "普通关闭和正式重启保留未过期 pending challenge；logout 的既有 generation 变更仍清除 pending challenge",
      "oneUse": "持久化消费在凭证 mutation lock 内原子移除；同一 code 至多签发一个 session",
      "sessions": "签发和成功配对都不旋转 session generation，不吊销同一 generation 的其他独立配对终端",
      "failure": "typed durable issue failure：不返回 code，不创建 project manifest 或 daemon lease",
      "controlRoot": "control-root 优先级为本次显式 --control-root → HUMANAGENT_HOME → 固定 ~/.humanagent/default-product.toml 声明 → ~/.humanagent；显式 flag 或环境已选时短路，不读取或校验低优先级声明",
      "productSelection": "pair 只消费同一 config owner 解析出的 ProductPaths；不读取 workspace、lease、daemon owner 或 HTTP 端点，默认声明只在没有更高优先级选择时决定 root"
    },
    "implementationGap": "当前 CLI pair 先解析 workspace、读取 active lease 并请求 supervisor HTTP challenge；AccessControlService 的 challenge 是进程内 Map。resolveProductPaths、默认产品声明读取、持久 challenge 与本地签发尚未实现；P 承接凭证 owner，C1 待 D/P 后接线。本图是待实现候选，不证明运行时能力。"
  },
