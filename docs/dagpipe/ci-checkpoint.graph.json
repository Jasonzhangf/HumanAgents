{
  "id": "humanagent-ci-checkpoint",
  "version": "1",
  "meta": {
    "title": "CI 检查点：类型检查、编译与服务回归"
  },
  "inputs": [
    { "id": "project_source", "schema": "Object" }
  ],
  "nodes": [
    {
      "id": "typecheck",
      "operator": "humanagent-ci-typecheck",
      "operator_version": "1",
      "inputs": ["project_source"],
      "output": { "id": "typecheck_record", "schema": "Object" },
      "input_selector": { "include": [], "exclude": [], "predicate": null },
      "output_selector": { "include": [], "exclude": [], "predicate": null },
      "iterator": "Whole"
    },
    {
      "id": "compile",
      "operator": "humanagent-ci-compile",
      "operator_version": "1",
      "inputs": ["typecheck_record"],
      "output": { "id": "compiled_artifacts", "schema": "Object" },
      "input_selector": { "include": [], "exclude": [], "predicate": null },
      "output_selector": { "include": [], "exclude": [], "predicate": null },
      "iterator": "Whole"
    },
    {
      "id": "regression",
      "operator": "humanagent-ci-regression",
      "operator_version": "1",
      "inputs": ["compiled_artifacts"],
      "output": { "id": "regression_record", "schema": "Object" },
      "input_selector": { "include": [], "exclude": [], "predicate": null },
      "output_selector": { "include": [], "exclude": [], "predicate": null },
      "iterator": "Whole"
    }
  ],
  "edges": [
    { "from": "typecheck", "to": "compile", "arc_id": "typecheck_record" },
    { "from": "compile", "to": "regression", "arc_id": "compiled_artifacts" }
  ],
  "outputs": ["regression_record"]
}
