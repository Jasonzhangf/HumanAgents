{
  "id": "humanagent-explicit-requirement",
  "version": "3",
  "meta": {
    "title": "用户新任务从可读草稿、修订、精确确认到单次最终提交并进入需求队列与执行计划",
    "baseline": "0020ab4f4442ea59bf4b9fc02416a8a77c6c68ed",
    "designStatus": "candidate",
    "capabilityStatus": "partial",
    "ownershipContract": {
      "W1": "contracts-only shared exports; no runtime implementation",
      "W1b": "core draft invariant and runtime intake/router; consumes W1 and existing journal port",
      "W2": "subscription core exports only after W1b serial handoff",
      "W4": "UI consumers require W1 exports and W3 runtime/projection handoff"
    },
    "terminalContract": {
      "success": "requirement_processing_result",
      "immediateDispatch": "真实 final receipt 按 requirementId/draftId/inputRevision/fifoSeq/payloadRef 匹配 FIFO，建立 TaskIdentity 后才进入独立 TaskGrant 准入；失败保留未确认消费责任",
      "runtimeIdentity": "AccessControl 稳定产品身份只提供 owner；不表示 session 或 grant；实际 allocation 经同一 coordinator release 原子准入",
      "failure": "draft revision or authorization failure returns explicit error and preserves input",
      "cancel": "rejected closure before dispatch; in-flight stop is separate",
      "blocked": "clarification required; draft remains editable",
      "cleanup": "interaction closure receipt retained; stale confirmation explicitly rejected",
      "duplicate": "same draft revision and idempotency key returns existing finalSubmit receipt without a second requirement append or dispatch",
      "staleRevision": "old confirmation or old revision is rejected with explicit confirmation-stale or stale-revision failure and the current draft remains editable",
      "rejectClosure": "explicit rejectDraft records a durable DraftRejectClosure and keeps the interaction input available for a later retry of the same request path",
      "restart": "preview, revision history, confirmation, final-submit receipt, and inbox transaction replay from explicit-intake and requirement-inbox durable state"
    },
    "productionWiringStatus": "WIRED",
    "productionWiringGap": "本图关键边已接线：confirmTypedExplicitRequirement 调用真实的 RequirementSubmissionOwner.submitFinal，并在 executionPolicy 存在时经 persistAuthorizedExecutionPlan→SubscriptionControlPort.create 落成 Subscription（packages/app/src/ui-runtime/service.ts:2819-2831, 2949-2972）；端到端到点执行由 packages/app/src/ui-runtime/scheduler.ts 驱动。仍在的相邻事实（不阻断本图）：RequirementSubmissionOwner 的 RequirementSubmitPort.submit 仍是只回显 requirementId 的桩（service.ts:1007），执行计划落库不经该桩",
    "productionWiringOwner": "T14",
    "productionWiringEvidence": "packages/app/src/ui-runtime/service.ts:2819 submitFinal 与 :2972 SubscriptionControlPort.create；packages/runtime/src/explicit-brain/router.ts:617 RequirementSubmissionOwner.submitFinal/rejectDraftRevision；tests/app/scheduler-production-wiring.test.ts 经真实 HTTP 确认路径落成计划并到期执行",
    "constraintFidelityContract": "用户确认的 goal、scope、constraints、deliverables 由服务层现有 canonical JSON 模板统一承载。同一 normalizedInput 必须从 typed revision 进入 RequirementEnvelope，再进入 Task.directive 与首次 executor 输入；Task.title 单独使用可读 goal。closed-turn Planner 读取同一 Task.directive，且计划节点、验收项与 decision 必须遵守其中 constraints/deliverables；提示词传达不证明模型实际合规。StageA 只准备图、真实 HTTP 反例与提示契约，不宣称 service 修复完成。",
    "constraintFidelityOwner": "packages/app/src/ui-runtime/service.ts typed confirmation/template serializer/dispatch；packages/runtime/src/orchestration/closed-turn-planner-call.ts Planner output contract；tests/app/new-task-identity-public-consumer.test.ts public HTTP consumer"
  },
