{
  "id": "humanagent-explicit-requirement",
  "version": "2",
  "meta": {
    "title": "用户新任务从可读草稿到单次最终提交并编译持久化执行计划",
    "baseline": "0020ab4f4442ea59bf4b9fc02416a8a77c6c68ed",
    "designStatus": "candidate",
    "capabilityStatus": "pending",
    "ownershipContract": {
      "W1": "contracts-only shared exports; no runtime implementation",
      "W1b": "core draft invariant and runtime intake/router; consumes W1 and existing journal port",
      "W2": "subscription core exports only after W1b serial handoff",
      "W4": "UI consumers require W1 exports and W3 runtime/projection handoff"
    },
    "terminalContract": {
      "success": "persisted_execution_plan",
      "failure": "draft revision or authorization failure returns explicit error and preserves input",
      "cancel": "rejected closure before dispatch; in-flight stop is separate",
      "blocked": "clarification required; draft remains editable",
      "cleanup": "interaction closure receipt retained; stale confirmation explicitly rejected"
    }
  },
