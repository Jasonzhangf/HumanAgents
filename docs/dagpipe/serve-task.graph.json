    "replayRule": "settlement -> same receipt；checkpoint+receipt -> reconstruct/read receipt；checkpoint only -> durable unverified；admission only -> wait/in-progress/interrupted；no admission -> admit once",
    "capabilityResolution": "组合 W3 verification bytes；持久 ServeTaskTerminalReceipt Fact；最小扩展 claim executionOwner/daemonLease/generation/processStartToken；在现有 supervisor 增加 typed withCurrentDaemonOwner guard；真实 ServeTaskConsumerPort",
    "ownerFenceStatus": "BLOCKED; no source implementation or runtime proof",
    "ownerFenceMissingPrimitive": "public typed supervisor operation equivalent to withCurrentDaemonOwner(paths, executionOwner, operation)",
    "ownerFenceGuardOrder": "existing withDaemonLeaseGuard -> re-read current lease -> validate execution owner -> journal.transaction append; same scope; release in finally",
    "graphStatus": "design; not runtime execution evidence"
  },
