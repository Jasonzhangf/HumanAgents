{
  "id": "humanagent-serve-task",
  "version": "2",
  "meta": {
    "title": "serve 运行时从已授权执行计划到真实任务终态与恢复责任",
    "baseline": "0020ab4f4442ea59bf4b9fc02416a8a77c6c68ed",
    "designStatus": "candidate",
    "capabilityStatus": "pending",
    "verificationContract": {
      "producer": "TaskExecutionEvidence { taskId, operationId, executionEpoch, inputArtifactDigest, stdout, exitCode, evidenceRefs }",
      "consumer": "TaskVerificationResult { taskId, operationId, executionEpoch, inputArtifactDigest, status, checkerStdout, checkerExitCode, evidenceRefs }",
      "status": "success | failed | rejected | missing | blocked | cancelled",
      "terminalMapping": {
        "success": "checkpoint succeeded only after checker success",
        "failed": "checkpoint failed with original stdout/exit preserved",
        "rejected": "non-success terminal with checker rejection evidence",
        "missing": "explicit non-success, then cleanup/recovery before checkpoint",
        "blocked": "waiting/blocked checkpoint with checker owner and recovery condition",
        "cancelled": "cancelled checkpoint only after stop settlement"
      },
      "authority": "typed control; never inferred from business payload, metadata, or logs",
      "reuseBoundary": "OperationVerifierDecision remains operation-scoped; task-level results use TaskVerificationResult rather than impersonating that contract"
    },
    "terminalContract": {
      "success": "task_terminal with checkpoint and readable result",
      "failure": "task_terminal with original error and recovery responsibility",
      "cancel": "stop operation settled before cancelled state",
      "blocked": "attention with exact blocked object and user action",
      "cleanup": "settlement receipt, provider close result, missing/rejected verification cleanup, and no false stopped state"
    }
  },
