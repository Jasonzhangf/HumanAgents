{
  "id": "humanagent-implicit-turn-closure",
  "version": "2",
  "meta": {
    "title": "隐式编排者动态选择子代理、提交步骤检查点并在轮次收口时校验公开交付",
    "requirements_version": 19,
    "requirements": [
      "humanagent-explicit-brain-semantic-turn-context",
      "humanagent-implicit-brain-budgeted-independent-orchestration",
      "humanagent-dynamic-orchestrator-choice-and-agent-termination",
      "humanagent-turn-checkpoint-four-part-summary-and-planner-iteration",
      "humanagent-orchestrator-delegation-and-refined-result-context",
      "humanagent-standard-turn-closure-forced-reasoning-and-same-turn-recovery",
      "humanagent-transient-goal-oriented-continuation-prompt",
      "humanagent-generic-reorientation-prompt-and-boolean-stop-control",
      "humanagent-explicit-brain-simple-answer-or-standard-task-routing",
      "humanagent-continuation-oriented-by-explicit-dispatch-template"
    ],
    "designStatus": "USER-REQUIREMENT-DESIGN-REVIEWED",
    "implementationStatus": "UNVERIFIED",
    "bindingBoundary": "语义设计责任名称，不声明 Operator 已注册或 runtime 执行",
    "outcomeBoundary": "编排者自主选择探索、规划、执行或审查步骤；每一步绑定 planRevisionId 与 stepId 并使用独立上下文；每次子代理完成先提交该步骤检查点；轮次收口只在校验公开交付通过后进入下一计划，否则强制续推。",
    "existingCheckpointDesign": "native-turn-checkpoint.graph.json",
    "trigger": "已派发复杂任务的隐式编排轮次；不套用于简单问答。",
    "deliveryContract": "校验节点只消费已确认的标准交付来源与结构化 summary.result.text；不声明传输完成、任务成功，也不重复保存正文。",
    "terminalAcceptanceContract": "validate_canonical_public_output 在声明完成时执行唯一公开交付校验；通过后接受 succeeded/final，未通过进入 force_continuation_reasoning。canonical output 不得使用 native drain 或 summary。不强制角色顺序，也不新增模型完成标签。",
    "adoptionContract": "planner_align_iteration 接受正式计划与定义；不把角色顺序或自由文本当作执行契约。",
    "logicalTurnSettlementContract": "提交轮次检查点后由独立 Planner 对齐并产出下一计划；continue 保留共享轮次，complete/failed 以 canonical alignment 引用关闭轮次，不冒充用户停止或改写任务状态。"
  },
