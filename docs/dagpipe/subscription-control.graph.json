{
  "id": "humanagent-subscription-control",
  "version": "1",
  "meta": {
    "title": "订阅控制请求从公开入口到持久化回执",
    "baseline": "0020ab4f4442ea59bf4b9fc02416a8a77c6c68ed",
    "designStatus": "candidate",
    "capabilityStatus": "pending",
    "controlContract": {
      "request": "SubscriptionControlRequest = ModifySubscriptionControlRequest | PauseSubscriptionControlRequest | ResumeSubscriptionControlRequest | CancelFutureSubscriptionControlRequest",
      "modify": "ModifySubscriptionControlRequest { action:'modify', newPolicy: ExecutionPolicyDefinition, newPolicyHash, confirmationRef, expectedPolicyRevision, expectedScheduleRevision, idempotencyKey, requestedAt }",
      "receipt": "SubscriptionControlReceipt { subscriptionId, action, status, policyRevision, scheduleRevision, idempotencyKey, requestHash, supersededUnclaimedOccurrences, controlRef }",
      "transactionResource": "packages/adapters/jsonl/src/index.ts:transaction",
      "criticalSection": "begin_subscription_control_transaction -> decide_subscription_control -> commit_subscription_control",
      "linearization": [
        "control does not depend on due_occurrence; pause/resume/cancel-future commit a durable receipt even when no due slot exists",
        "control committed before claim supersedes old unclaimed occurrences; claim rechecks committed state and revision and returns typed stale/conflict",
        "claim committed before control keeps the authorized immutable policy snapshot for that executionEpoch; future pause/cancel-future does not stop in-flight execution",
        "two modifies from the same base revision produce exactly one applied receipt and typed stale/conflict for the losers",
        "duplicate idempotencyKey with the same requestHash returns the existing receipt; different content returns conflict",
        "resume generates deterministic future slots and never reissues superseded occurrences",
        "journal restart replay restores committed subscription state and receipts"
      ]
    },
    "terminalContract": {
      "success": "durable_subscription_control_receipt(status=applied)",
      "duplicate": "durable_subscription_control_receipt(status=duplicate)",
      "stale": "durable_subscription_control_receipt(status=stale)",
      "conflict": "durable_subscription_control_receipt(status=conflict)",
      "failure": "typed control rejection before transaction commit; subscription unchanged and no success receipt"
    }
  },
