{
  "id": "humanagent-conversation-scope-entry",
  "version": "1",
  "meta": {
    "title": "会话入口范围路由：Alex 与项目 Jenny 的读取和提交",
    "description": "固定 /api/main-topic 与 /api/explicit/inputs 入口按 typed scope 解析；GET 只读不持久化，POST 首条按稳定 scope 与幂等键交给真正接收输入的 owner，随后复用既有显式轮次子图，权威事实按相同 scope 持久化并统一返回。",
    "designStatus": "candidate",
    "capabilityStatus": "pending",
    "scopeContract": "裸入口与 scope=system 归一到 {kind:alex}；scope=project&projectKey 解析到唯一 Jenny。身份和权限来自 config，URL 只选择目标。",
    "readOnlyContract": "GET 读取既有事实或返回空投影，不创建 session/scope 状态、不 backfill legacy、不调用 provider。",
    "submitContract": "POST 首条才 ensure 唯一主会话；幂等键传到真正接收输入的 owner；重复键返回原 interaction，不新增消息或二次 bootstrap。只读与写入共用同一 scope 路由。",
    "isolationContract": "Alex 不携带 projectKey、workspace 或项目历史；跨 scope 的 inspect/interpret/continue/events 以 scope.interaction-not-found 拒绝。",
    "terminalContract": {
      "success": "同一 scope 的读取结果或提交后轮次结果",
      "failure": "未知/歧义范围或未接通操作显式失败，保留原 scope 与恢复责任",
      "cancel": "标准停止收拢，HTTP 取消不等于业务取消",
      "cleanup": "只读路径无副作用"
    }
  },
