{
  "name": "humanagent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "devDependencies": {
    "@humanagent/contracts": "workspace:*",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:contracts": "tsc -p packages/contracts/tsconfig.json && tsc -p tests/contracts/tsconfig.json",
    "build:config": "tsc -p packages/config/tsconfig.json",
    "build:app": "tsc -p packages/app/tsconfig.json",
    "build:runtime": "tsc -p tests/runtime/tsconfig.json && tsc -p tests/runtime/admission/tsconfig.json && tsc -p tests/runtime/checkpoints/tsconfig.json && tsc -p tests/runtime/control/tsconfig.json && tsc -p tests/runtime/intake/tsconfig.json && tsc -p tests/runtime/memory/tsconfig.json && tsc -p tests/runtime/nodes/tsconfig.json && tsc -p tests/runtime/review/tsconfig.json",
    "build:tests": "tsc -p tests/config/tsconfig.json && tsc -p tests/app/tsconfig.json",
    "build:raw": "node scripts/clean-build.mjs && pnpm build:contracts && pnpm build:config && pnpm build:app && pnpm build:runtime && pnpm build:tests",
    "build": "node scripts/run-build.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:contracts": "pnpm build:contracts && node --test dist/tests/tests/contracts/contracts.test.js",
    "test:config": "pnpm build:config && tsc -p tests/config/tsconfig.json && node --test dist/tests/tests/config/config.test.js",
    "test:app": "pnpm build:app && tsc -p tests/app/tsconfig.json && node --test dist/tests/tests/app/app.test.js",
    "test:release": "node --test tests/release/release-gates.test.mjs",
    "test:runtime": "pnpm build:runtime && node --test dist/tests/runtime/admission/admission.test.js dist/tests/tests/runtime/checkpoints/checkpoint-coordinator.test.js dist/tests/tests/runtime/control/control.test.js dist/tests-runtime-intake/tests/runtime/intake/intake.test.js dist/tests/tests/runtime/memory/memory-coordinator.test.js dist/tests/runtime/nodes/tests/runtime/nodes/agent-runtime.test.js dist/tests/runtime/nodes/tests/runtime/nodes/node-runtime.test.js dist/tests/tests/runtime/review/review-coordinator.test.js dist/tests/tests/runtime/integration/wave2-assembly.test.js",
    "test:compiled": "node --test dist/tests/tests/contracts/contracts.test.js dist/tests/tests/config/config.test.js dist/tests/tests/app/app.test.js dist/tests/runtime/admission/admission.test.js dist/tests/tests/runtime/checkpoints/checkpoint-coordinator.test.js dist/tests/tests/runtime/control/control.test.js dist/tests-runtime-intake/tests/runtime/intake/intake.test.js dist/tests/tests/runtime/memory/memory-coordinator.test.js dist/tests/runtime/nodes/tests/runtime/nodes/agent-runtime.test.js dist/tests/runtime/nodes/tests/runtime/nodes/node-runtime.test.js dist/tests/tests/runtime/review/review-coordinator.test.js dist/tests/tests/runtime/integration/wave2-assembly.test.js",
    "test": "pnpm test:contracts && pnpm test:config && pnpm test:app && pnpm test:runtime",
    "ci:check": "pnpm run typecheck && pnpm run test && pnpm run test:release",
    "doctor": "pnpm build:app && node dist/app/app/src/cli.js doctor",
    "run": "pnpm build:app && node dist/app/app/src/cli.js run",
    "resume": "pnpm build:app && node dist/app/app/src/cli.js resume",
    "ci": "node scripts/run-ci.mjs",
    "release": "pnpm run release:check",
    "package": "pnpm run package:release",
    "package:release": "node scripts/package-release.mjs",
    "package:candidate": "node scripts/package-candidate.mjs",
    "package:smoke": "node scripts/verify-package.mjs",
    "install:global": "node scripts/install-global.mjs",
    "uninstall:global": "node scripts/uninstall-global.mjs",
    "release:check": "node scripts/check-release.mjs",
    "smoke": "node scripts/smoke.mjs"
  }
}
