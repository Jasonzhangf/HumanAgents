{
  "name": "humanagent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "devDependencies": {
    "@humanagent/contracts": "workspace:*",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
