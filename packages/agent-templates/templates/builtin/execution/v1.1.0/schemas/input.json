{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanagent://agent-templates/execution/1.1.0/input",
  "title": "Execution Assignment Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignmentId",
    "taskId",
    "pipelineNodeId",
    "attempt",
    "executionEpoch",
    "inputRevision",
    "objective",
    "acceptanceCriteriaDigest",
    "requiredCapabilities"
  ],
  "properties": {
    "assignmentId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "pipelineNodeId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "executionEpoch": { "type": "integer", "minimum": 1 },
    "inputRevision": { "type": "integer", "minimum": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "targetRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "expectedOutputRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "expectedArtifactDigests": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "acceptanceCriteriaDigest": { "type": "string", "minLength": 1 },
    "successCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "failureCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "incompleteCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requiredCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "mergeGate": { "enum": ["required", "not-required"] }
  }
}
