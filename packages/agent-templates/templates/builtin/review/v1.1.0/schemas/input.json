{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanagent://agent-templates/review/1.1.0/input",
  "title": "Review Assignment Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignmentId",
    "taskId",
    "workerAgentId",
    "reviewKind",
    "attempt",
    "executionEpoch",
    "inputRevision",
    "acceptanceCriteriaDigest",
    "subjectRefs",
    "subjectDigests",
    "requiredCapabilities"
  ],
  "properties": {
    "assignmentId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "workerAgentId": { "type": "string", "minLength": 1 },
    "reviewKind": { "enum": ["architecture", "baseline", "quality", "security", "delivery"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "executionEpoch": { "type": "integer", "minimum": 1 },
    "inputRevision": { "type": "integer", "minimum": 1 },
    "acceptanceCriteriaDigest": { "type": "string", "minLength": 1 },
    "subjectRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "subjectDigests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "workerCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requiredCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "mergeGate": { "enum": ["required", "not-required"] }
  }
}
