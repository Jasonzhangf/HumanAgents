{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "humanagent://agent-templates/review/1.1.0/output",
  "title": "Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultId",
    "assignmentId",
    "taskId",
    "workerAgentId",
    "reviewKind",
    "attempt",
    "executionEpoch",
    "inputRevision",
    "acceptanceCriteriaDigest",
    "subjectRefs",
    "subjectDigests",
    "status",
    "findings",
    "evidenceRefs"
  ],
  "properties": {
    "resultId": { "type": "string", "minLength": 1 },
    "assignmentId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "workerAgentId": { "type": "string", "minLength": 1 },
    "reviewKind": { "enum": ["architecture", "baseline", "quality", "security", "delivery"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "executionEpoch": { "type": "integer", "minimum": 1 },
    "inputRevision": { "type": "integer", "minimum": 1 },
    "acceptanceCriteriaDigest": { "type": "string", "minLength": 1 },
    "subjectRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "subjectDigests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "status": { "enum": ["passed", "failed", "inconclusive"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "severity", "locationRef", "problem", "expected", "evidenceRefs"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["P0", "P1", "blocker", "important", "advisory"] },
          "locationRef": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "object" } }
        }
      }
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}
