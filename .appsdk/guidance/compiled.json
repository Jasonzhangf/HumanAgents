  "rules": [
    {
      "description": "Read only rule sources declared by the project contract.",
      "rule_id": "use-declared-sources",
      "severity": "forbidden"
    },
    {
      "description": "Execute only the projected node and adjacent workflow edges.",
      "rule_id": "adjacent-transition",
      "severity": "forbidden"
    },
    {
      "description": "A passing required step must bind evidence.",
      "rule_id": "evidence-required",
      "severity": "forbidden"
    },
    {
      "description": "Revise the plan after project, goal, source, scope, owner, or rule-context drift.",
      "rule_id": "context-drift",
      "severity": "forbidden"
    },
    {
      "description": "Do not overwrite or delete plan revisions and execution events.",
      "rule_id": "append-only-history",
      "severity": "forbidden"
    },
    {
      "description": "Do not claim lifecycle completion before canonical AppSDK gates pass.",
      "rule_id": "lifecycle-truth",
      "severity": "forbidden"
    },
    {
      "description": "New or changed control and configuration behavior must use declared typed control resources, error chains, or project configuration sources, never payloads, metadata, debug logs, or implicit context.",
      "rule_id": "changed-scope-control-truth",
      "severity": "forbidden"
    },
    {
      "description": "New or changed behavior must retain one semantic owner and one implementation, with no duplicate path, fallback, or temporary bypass.",
      "rule_id": "changed-scope-single-owner",
      "severity": "forbidden"
    },
    {
      "description": "Preserve fixed operation/hook/gate boundaries only where the project declares them. Missing required capabilities fail explicitly; never mock success.",
      "rule_id": "changed-scope-configured-orchestration",
      "severity": "forbidden"
    },
    {
      "description": "Compare deletion, reuse and direct implementation by actual complexity. Optional simplification does not block; concrete quality, safety or ownership regressions remain forbidden.",
      "rule_id": "changed-scope-ablation-and-sharing",
      "severity": "advisory"
    },
    {
      "description": "Report untouched historical violations as recommendations; do not block the candidate unless they enter changed scope or affect safety, ownership, evidence truth, or required delivery.",
      "rule_id": "historical-architecture-debt",
      "severity": "advisory"
    },
    {
      "description": "Locate feature and debug work in the declared function and verification maps before implementation.",
      "rule_id": "project-context-binding",
      "severity": "warning"
    },
    {
      "description": "During debug exploration, append observations, hypotheses, and evidence to the active run notes before resolution.",
      "rule_id": "debug-notes-required",
      "severity": "warning"
    },
    {
      "description": "Update function ownership and verification gates in the same change when the implementation changes them.",
      "rule_id": "map-gate-update",
      "severity": "advisory"
    },
    {
      "description": "Record requirement, architecture, and detailed-design closure before feature implementation.",
      "rule_id": "recommended-design",
      "severity": "warning"
    },
    {
      "description": "Check prior verified successes and failures before repeating exploration.",
      "rule_id": "prior-record-search",
      "severity": "advisory"
    }
  ],
